{
    "id": "ltd.mwbmpartners.ihymns.pwa",

    "name": "iHymns — Christian Hymns & Worship Songs",

    "short_name": "iHymns",

    "description": "Search and sing from thousands of Christian hymns and worship songs across dozens of songbooks, with favourites, set lists, dark mode and offline use.",

    "version": "1.3.0",

    "start_url": "/",

    "scope": "/",

    "display": "standalone",

    "display_override": [
        "window-controls-overlay",
        "standalone",
        "minimal-ui"
    ],

    "orientation": "any",

    "theme_color": "#4f46e5",

    "background_color": "#f8fafc",

    "lang": "en",

    "dir": "ltr",

    "categories": [
        "books",
        "education",
        "lifestyle",
        "music",
        "reference",
        "utilities"
    ],

    "prefer_related_applications": false,

    "related_applications": [
        {
            "platform": "webapp",
            "url": "https://ihymns.app/manifest.json"
        }
    ],

    "icons": [
        {
            "src": "/assets/favicon.svg",
            "type": "image/svg+xml",
            "sizes": "any",
            "purpose": "any"
        },
        {
            "src": "/assets/icon-48.png",
            "type": "image/png",
            "sizes": "48x48",
            "purpose": "any"
        },
        {
            "src": "/assets/icon-72.png",
            "type": "image/png",
            "sizes": "72x72",
            "purpose": "any"
        },
        {
            "src": "/assets/icon-96.png",
            "type": "image/png",
            "sizes": "96x96",
            "purpose": "any"
        },
        {
            "src": "/assets/icon-128.png",
            "type": "image/png",
            "sizes": "128x128",
            "purpose": "any"
        },
        {
            "src": "/assets/icon-144.png",
            "type": "image/png",
            "sizes": "144x144",
            "purpose": "any"
        },
        {
            "src": "/assets/icon-152.png",
            "type": "image/png",
            "sizes": "152x152",
            "purpose": "any"
        },
        {
            "src": "/assets/icon-192.png",
            "type": "image/png",
            "sizes": "192x192",
            "purpose": "any"
        },
        {
            "src": "/assets/icon-192.png",
            "type": "image/png",
            "sizes": "192x192",
            "purpose": "maskable"
        },
        {
            "src": "/assets/icon-256.png",
            "type": "image/png",
            "sizes": "256x256",
            "purpose": "any"
        },
        {
            "src": "/assets/icon-384.png",
            "type": "image/png",
            "sizes": "384x384",
            "purpose": "any"
        },
        {
            "src": "/assets/icon-512.png",
            "type": "image/png",
            "sizes": "512x512",
            "purpose": "any"
        },
        {
            "src": "/assets/icon-512.png",
            "type": "image/png",
            "sizes": "512x512",
            "purpose": "maskable"
        }
    ],

    "shortcuts": [
        {
            "name": "Search Songs",
            "short_name": "Search",
            "description": "Search for hymns and worship songs",
            "url": "/search",
            "icons": [
                {
                    "src": "/assets/icon-search.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Favourites",
            "short_name": "Favourites",
            "description": "View your favourite songs",
            "url": "/favorites",
            "icons": [
                {
                    "src": "/assets/icon-star.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Songbooks",
            "short_name": "Books",
            "description": "Browse all songbooks",
            "url": "/songbooks",
            "icons": [
                {
                    "src": "/assets/icon-book.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Help",
            "short_name": "Help",
            "description": "Get help using iHymns",
            "url": "/help",
            "icons": [
                {
                    "src": "/assets/icon-help.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        }
    ],

    "share_target": {
        "action": "/search",
        "method": "GET",
        "enctype": "application/x-www-form-urlencoded",
        "params": {
            "text": "q",
            "title": "q",
            "url": "q"
        }
    },

    "handle_links": "preferred",

    "launch_handler": {
        "client_mode": [
            "navigate-existing",
            "auto"
        ]
    },

    "scope_extensions": [
        {
            "type": "origin",
            "origin": "https://ihymns.app"
        },
        {
            "type": "origin",
            "origin": "https://www.ihymns.app"
        }
    ],

    "edge_side_panel": {
        "preferred_width": 400
    }
}
