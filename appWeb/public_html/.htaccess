# ==========================================================================
# iHymns — Apache Configuration (.htaccess)
#
# Copyright (c) 2026 iHymns. All rights reserved.
#
# PURPOSE:
# Handles URL rewriting for clean URLs (no .php extensions visible),
# API routing, GZIP compression, security headers, caching, and
# proper MIME type configuration.
#
# CLEAN URL STRATEGY:
#   - All navigation URLs (/, /song/CP-0001, /songbooks, etc.) are
#     rewritten to index.php for server-side rendering of OG meta tags
#     and client-side SPA routing via pushState.
#   - The API endpoint is accessed via /api (rewritten to api.php).
#   - Direct access to .php files is blocked (security: hides PHP).
#   - Static assets (CSS, JS, images, fonts) are served directly.
# ==========================================================================

# Enable the rewrite engine
RewriteEngine On

# ==========================================================================
# ADMIN AREA PASSTHROUGH (/manage/) + /admin/ alias (#407)
#
# The /manage/ directory has its own PHP authentication system and does
# not use the SPA router. All requests to /manage/ are served directly
# by PHP — they must bypass the .php blocking rule and the SPA catch-all.
#
# /admin/ is a permanent alias for /manage/ — same portal, friendlier URL.
# ==========================================================================

# /admin/<path> → /manage/<path> (301, preserves query string)
RewriteRule ^admin(/.*)?$ /manage$1 [R=301,L,QSA]

RewriteRule ^manage/ - [L]

# ==========================================================================
# BLOCK DIRECT ACCESS TO PHP FILES
#
# Security measure: prevents revealing that the server uses PHP.
# All PHP files must be accessed through clean URL rewrites.
# Exceptions: /manage/ (handled above, has its own auth).
# ==========================================================================

# Block direct access to any .php file (except internal rewrites)
RewriteCond %{THE_REQUEST} \.php[\s?/] [NC]
RewriteRule ^ - [R=404,L]

# ==========================================================================
# BLOCK ACCESS TO SENSITIVE FILES & DIRECTORIES
# ==========================================================================

# Block access to the includes directory entirely
RewriteRule ^includes/ - [F,L]

# Block direct HTTP access to internal Markdown docs (#1906).
# MUST be an access-phase deny, not a RewriteRule: the /manage/ passthrough
# (`RewriteRule ^manage/ - [L]` below) L-stops rewriting under /manage/, so a
# rewrite-based block would MISS the at-risk files (manage/editor/*.md served as
# static text/plain to anyone). A <FilesMatch>+Require runs in the authz phase,
# which the rewrite [L] does not bypass, so it covers the whole docroot. No
# client fetches a .md over HTTP (verified), so this breaks nothing.
<FilesMatch "\.md$">
    Require all denied
</FilesMatch>

# Block access to hidden files (e.g., .gitkeep, .env)
RewriteRule (^|/)\.(?!well-known) - [F,L]

# ==========================================================================
# API ROUTING
#
# /api?param=value → api.php?param=value
# Passes all query string parameters through transparently.
# ==========================================================================

RewriteRule ^api$ api.php [QSA,L]

# /og-image → og-image.php (hides PHP extension from OG meta tags)
RewriteRule ^og-image$ og-image.php [QSA,L]

# /song-media/<id> → song-media.php?id=<id>  (#853)
# Gated streaming endpoint for tblSongMedia rows. The handler does
# checkContentAccess('song', <SongId>) so this URL is safe to expose
# regardless of the song's restriction state. Only numeric ids are
# routed; any other shape falls through to the SPA catch-all and
# 404s naturally.
RewriteRule ^song-media/([0-9]+)$ song-media.php?id=$1 [L]

# /audio/<SongId>.mp3 → audio-media.php?id=<SongId>  (#1358)
# GATED streaming front door for the legacy static data/audio/*.mp3 files.
# The SongId shape is `<letters/digits>-<digits>` (rule #1332). This is a NEW
# URL space — nothing emits /audio/<id>.mp3 until audio_signing_enabled='1'
# (bulk_audio keeps emitting the legacy /data/audio/<id>.mp3 literal while
# off), so existing traffic is completely untouched. The handler is
# byte-equivalent to Apache's static serve when signing is OFF, and verifies a
# signed URL + the song's access rules when ON. Placed BEFORE the static -f
# L-stop below so the rewrite wins over a direct match.
RewriteRule ^audio/([A-Za-z0-9]+-[0-9]+)\.mp3$ audio-media.php?id=$1 [QSA,L]

# --- #1358 SEAL (DO NOT uncomment until rollout step 6) -------------------
# Once signed /audio/<id>.mp3 playback is verified ON THIS ENV, uncomment the
# block below to DENY direct access to the static data/audio/*.mp3 files, so
# the ONLY way to fetch gated audio is through the signed /audio/ route above.
# This is the one rollout step that FEELS irreversible (a wrong scope blocks
# legitimate audio) — apply it PER ENV, last, after verification, never as part
# of shipping this change.
#
# It MUST be an access-phase <Files>/<FilesMatch> deny (mod_authz), NOT a
# RewriteRule: a rewrite could race the static -f passthrough below and is
# order-sensitive, whereas an access-phase deny is unconditional. Scope it to
# this server's actual layout — if data/audio is reachable at /data/audio/ from
# the docroot, a directory-scoped rule (e.g. an .htaccess INSIDE data/audio/
# with `Require all denied`, or a <Directory> block in the vhost) is cleaner
# than a docroot-wide FilesMatch that could also catch unrelated *.mp3. Verify
# the scope against THIS env before uncommenting.
#
# <FilesMatch "\.mp3$">
#   Require all denied
# </FilesMatch>
# -------------------------------------------------------------------------

# ==========================================================================
# SERVICE WORKER ROUTING (#81)
#
# /service-worker.js → service-worker.js.php
# The service worker is generated by PHP so that the cache version is
# automatically derived from infoAppVer.php (always in sync with app version).
# ==========================================================================

RewriteRule ^service-worker\.js$ service-worker.js.php [L]

# ==========================================================================
# SITEMAP ROUTING (#151)
#
# /sitemap.xml → sitemap.xml.php
# The sitemap is generated dynamically by PHP to include all songs,
# songbooks, writers, and static pages from the song database.
# ==========================================================================

RewriteRule ^sitemap\.xml$ sitemap.xml.php [L]

# ==========================================================================
# APPLE APP SITE ASSOCIATION ROUTING (#1401)
#
# /.well-known/apple-app-site-association → .well-known/apple-app-site-association.php
# Apple's Universal Links fetcher requires this exact, extensionless path
# (no redirect, HTTPS, application/json). It is PHP-generated (not a static
# file) so the Apple Team ID it embeds can be updated from tblAppSettings
# without a code deploy — see the .php file's header comment. The dotfile
# block rule above already carves out `.well-known/` (`(?!well-known)`), so
# this clean extensionless request reaches this rule; the ".php file direct
# access" block earlier only inspects the ORIGINAL request line, so this
# internal rewrite target is unaffected (same pattern as /api, /sitemap.xml,
# /service-worker.js above).
# ==========================================================================

RewriteRule ^\.well-known/apple-app-site-association$ .well-known/apple-app-site-association.php [L]

# ==========================================================================
# DIRECTORY-LISTING KILL (#1906)
# A request that maps to a real DIRECTORY with no index.php of its own has
# no legitimate response — without this it would fall through the -d
# passthrough below into mod_autoindex, and whether that lists the
# directory's contents is a HOST default (+Indexes) we don't control.
# Deliberately mod_rewrite, NOT `Options -Indexes`: the Options directive
# 500s the ENTIRE site if the host's AllowOverride excludes `Options`
# (an <IfModule> wrapper does NOT prevent that — the directive is still
# parsed whenever the module is present), while mod_rewrite is already
# load-bearing in this file. Directories WITH an index.php (/, /manage/…)
# are excluded and keep working via DirectoryIndex.
# `^.+` (not `^`) exempts the docroot itself. ErrorDocument 404 below
# serves the themed SPA 404 body, matching #1905's contract.
# NOTE (#1906 also asked about ServerSignature Off): NOT set here —
# Apache's default is already Off, ServerTokens can't be set from
# .htaccess at all, and with listings dead the signature has nowhere
# user-visible left to render. Host check: `curl -sI /<nonexistent>`.
# ==========================================================================
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.php !-f
RewriteRule ^.+ - [R=404,L]

# ==========================================================================
# STATIC ASSET PASSTHROUGH
#
# Allow direct access to static files (CSS, JS, images, fonts, data).
# These do NOT get rewritten to index.php.
# ==========================================================================

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ==========================================================================
# STATIC-ASSET-DIRECTORY 404 (#1832 / rule #1566 class, issue #9 of this pass)
#
# ELI5: if a CSS/JS fallback (e.g. a #1832 vendor-CDN-down fallback) points at
# a /vendor/... file that was never actually deployed, the block above does
# NOT match (the file doesn't exist), so without this rule the request would
# fall through to the SPA catch-all below and get index.php's HTML back with
# an HTTP 200. A <link>/<script> tag doesn't care that the body is HTML, not
# CSS/JS — it just fails to apply/execute with NO console error, because as
# far as the browser is concerned the request "succeeded". That's the same
# silent-failure shape rule #1566 documents for relative-URL fetch() calls.
#
# DETAILED: this rule sits AFTER the real-file/-directory passthrough above
# (so any file that genuinely exists under these prefixes already L-stopped
# there and never reaches this line) and BEFORE the SPA catch-all below, and
# matches by PATH PREFIX rather than file extension: no SPA client route
# starts with vendor/, css/, js/, or fonts/ (verified against the route set —
# home, song, songbook, search, settings, favorites, help, terms, privacy,
# etc. — none of them do), so this can never intercept a legitimate SPA
# navigation. A missing asset under one of these prefixes now gets a real
# HTTP 404 instead of masquerading as a 200'd HTML page — loud failure
# instead of silent. `ErrorDocument 404 /index.php` below still serves the
# themed SPA 404 *body* for a human hitting the URL directly; the fix here is
# the STATUS CODE a script/stylesheet loader actually inspects, not the body.
# Mirrored in tests/browser/router.php's dev-server routing so the two agree
# (rule #35 — cross-file agreement needs a mechanism, not a comment).
# ==========================================================================

RewriteRule ^(vendor|css|js|fonts)/ - [R=404,L]

# ==========================================================================
# BAD-BOT / SCANNER PROBE DENY-LIST (#1905)
#
# Extensionless, directory-style scanner probes — /wp-admin/, /wp-content/,
# /wp-includes/…, /wordpress/, /phpmyadmin/, /administrator/, /adminer/,
# /autodiscover/autodiscover.xml, /cgi-bin/… — have NO .php extension (so the
# request-line ".php" 404 above misses them) and match no real asset prefix, so
# without this they fall through to the SPA catch-all below and get index.php's
# shell at HTTP 200 — telling a scanner the path is "valid" and logging as
# request.success. This returns a real 404 before PHP even runs. [NC] is
# load-bearing: scanners randomise case (WP-, PhpMyAdmin, ADMINISTRATOR).
#
# The eleven leading tokens are RESERVED probe prefixes — never begin a real SPA
# route with one. CI (tests/php/test-route-allowlist-coverage.php) enforces that
# no valid route segment starts with any of them, and that this alternation stays
# byte-identical to its mirror in tests/browser/router.php (rule #35).
#
# Placement: AFTER the real-file/-dir passthrough above (so a genuine asset always
# wins) and the vendor 404, BEFORE the SPA catch-all. index.php's own derived
# allow-list (#1905, includes/spa_routes.php) is the UNIVERSAL backstop that 404s
# every OTHER unknown path; this rule just short-circuits the highest-volume
# families cheaply, before PHP runs.
# ==========================================================================

RewriteRule ^(wp-|wordpress|xmlrpc|phpmyadmin|adminer|dbadmin|mysqladmin|administrator|autodiscover|autoconfig|cgi-bin) - [R=404,L,NC]

# ==========================================================================
# SPA CATCH-ALL — Rewrite all other requests to index.php
#
# This handles all clean URL navigation:
#   /              → index.php (home)
#   /songbooks     → index.php (JS router handles the route)
#   /songbook/CP   → index.php (JS router handles the route)
#   /song/CP-0001  → index.php (OG meta tags + JS routing)
#   /search        → index.php
#   /favorites     → index.php
#   /settings      → index.php
#   /help          → index.php
#   /terms         → index.php
#   /privacy       → index.php
#
# index.php reads the URL path for dynamic OG meta tags (share links),
# then the JavaScript SPA router takes over for client-side navigation.
# ==========================================================================

RewriteRule ^ index.php [QSA,L]

# ==========================================================================
# MIME TYPES — Ensure correct Content-Type headers
# ==========================================================================

<IfModule mod_mime.c>
    # JavaScript modules
    AddType text/javascript .js .mjs

    # JSON
    AddType application/json .json

    # OpenAPI spec — /api-docs.yaml is served as a plain docroot file to
    # Swagger UI at /manage/api-docs and to anyone who downloads it (#1587).
    # Without this Apache falls back to text/plain (or, on some shared hosts,
    # offers it as a download). application/yaml is the registered type as of
    # RFC 9512. Swagger UI parses it either way — this is correctness, not a fix.
    AddType application/yaml .yaml .yml

    # Web App Manifest
    AddType application/manifest+json .json

    # Apple App Site Association — must be application/json (#99, #1401)
    # Anchored to the EXACT extensionless filename: the PHP responder
    # (.well-known/apple-app-site-association.php, #1401) sets its own
    # Content-Type via header() and must NOT also match this FilesMatch —
    # an unanchored substring match would hit both filenames and risk
    # Apache's ForceType racing the script's own header.
    <FilesMatch "^apple-app-site-association$">
        ForceType application/json
    </FilesMatch>

    # SVG
    AddType image/svg+xml .svg .svgz
    AddEncoding gzip .svgz

    # Fonts
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType application/font-sfnt .ttf
    AddType application/vnd.ms-fontobject .eot

    # MIDI audio
    AddType audio/midi .mid .midi

    # PDF
    AddType application/pdf .pdf

    # Web manifest (explicit)
    AddType application/manifest+json manifest.json
</IfModule>

# ==========================================================================
# GZIP COMPRESSION — Reduce transfer sizes
# ==========================================================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE application/font-sfnt
</IfModule>

# ==========================================================================
# CACHE CONTROL
#
# Beta: aggressive no-cache to ensure fresh content during development.
# Production: these would be set to longer cache durations.
# ==========================================================================

<IfModule mod_headers.c>
    # Service worker — never cache (must always be fresh)
    <FilesMatch "service-worker\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Manifest — short cache
    <FilesMatch "manifest\.json$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # HTML/PHP output — no cache in beta
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # CSS and JS — always revalidate so deploys take effect immediately.
    # ES module graphs make per-file cache-busting impractical (only the
    # entry script tag carries ?v=...; its static imports do not), and
    # the semver bumps only on release, not on every alpha/beta deploy.
    # "no-cache, must-revalidate" still caches the response but forces a
    # conditional GET — the server answers 304 when unchanged (cheap) and
    # sends fresh bytes only when the file really changed.
    <FilesMatch "\.(css|js|mjs)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Images and fonts — longer cache
    <FilesMatch "\.(png|jpg|jpeg|gif|svg|ico|woff2|woff|ttf|eot)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>

    # JSON data — short cache
    <FilesMatch "songs\.json$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>

# ==========================================================================
# SECURITY HEADERS
# ==========================================================================

<IfModule mod_headers.c>
    # `always` (not bare `set`) so every directive attaches to ERROR responses
    # too — a 403 channel-gate/maintenance page, a 503 DB-down page, and the
    # #1905/#1906 404s are served via ErrorDocument, and a bare `Header set`
    # writes only the onsuccess table (2xx/3xx), silently dropping these on 4xx/5xx.
    # HSTS in particular MUST survive an error hit or a first-visit MITM isn't
    # pinned to HTTPS. Cache directives (below) stay `set` — errors shouldn't cache.

    # X-Powered-By (#1906): brand it "iHymns/<version>" instead of leaking the PHP
    # runtime version. The version is a deploy-injected PHP value, so PHP sets the
    # branded header (index.php / api.php -> ihymns_emit_powered_by_header()); the
    # PHP runtime version is suppressed at source by expose_php=Off (sibling
    # .user.ini). This `edit` is the belt-and-braces for a mod_php host that
    # ignores .user.ini: it rewrites ONLY a leaked "PHP/x.y" value to our bare
    # name, and — because it matches on value, not blanket-unset — it leaves the
    # PHP-set "iHymns/<version>" brand untouched (it doesn't match ^PHP/). On the
    # normal FastCGI/FPM host expose_php=Off means there's nothing to rewrite.
    Header always edit X-Powered-By "^PHP/.*$" "iHymns"

    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # X-XSS-Protection: OWASP now advises "0" (#1906). The legacy "1; mode=block"
    # auditor is removed from all modern browsers and has itself caused XSS /
    # info-leak side channels; the enforcing nonce CSP (index.php, rule #30) is
    # the real defence. "0" explicitly disables the legacy filter where honoured.
    Header always set X-XSS-Protection "0"

    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions policy — disable unnecessary APIs
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"

    # HSTS — Enforce HTTPS (1 year, include subdomains)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Cross-Origin policies
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

# ==========================================================================
# ERROR HANDLING
#   404 → the SPA shell (the JS router renders the themed "page not found").
#   403 / 405 / 500 / 503 → the standalone themed error page (error.php),
#   which matches the user's light / dark / high-contrast theme.
#   App-generated 403/500/503 bodies (maintenance, DB-down, channel gate)
#   already send their own themed body, so ErrorDocument only fires for
#   body-less SERVER-LEVEL errors — i.e. ones Apache itself raises before PHP
#   gets a say.
#
#   405 is the one addition here (#1704): unlike 413/416/410, Apache CAN
#   raise a 405 itself — a POST/PUT to a real static file passes the
#   STATIC ASSET PASSTHROUGH `-f` check below and the core handler then
#   refuses the non-GET method before any script runs. Bots and mis-wired
#   forms produce this in the wild; without this line they'd see the stock
#   Apache 405 page instead of a themed one.
#
#   The other emitted-but-unrouted statuses were considered and rejected:
#     - 413 — no LimitRequestBody is configured, and per Apache's own docs
#       the client's connection is often closed mid-upload before it ever
#       reads an ErrorDocument body. Wiring one here would be silent noise.
#     - 416 — only raised for static Range requests; the receiver in that
#       case is always a media element (<audio>/<video>), which never
#       renders a response body regardless of what's served.
#     - 410 — Apache never raises this here (no `Redirect gone` / `[G]`
#       rule exists in this file); every 410 is PHP-emitted with its own
#       themed body already (includes/pages/song.php), which pre-empts
#       ErrorDocument entirely.
#
#   ⚠️ Never point an ErrorDocument at /index.php for anything but 404. That
#   would render the SPA shell's 200-semantics HTML over a non-200 status —
#   the exact "200 + shell answers everything" trap this file elsewhere
#   works to avoid. error.php re-asserts the real status from
#   REDIRECT_STATUS instead (see error.php's own doc-block).
#
#   Note: ErrorDocument directives here are DOCROOT-wide and therefore also
#   apply under /manage/ (the ADMIN AREA PASSTHROUGH above only affects the
#   .php-blocking and SPA-catch-all rules, not ErrorDocument). An admin URL
#   that trips a server-level 403/405/500/503 will render this same public
#   error page rather than an admin-themed one — that's fine (error.php is
#   fully self-contained) but is worth knowing so it doesn't look like a
#   routing bug.
# ==========================================================================

ErrorDocument 404 /index.php
ErrorDocument 403 /error.php
ErrorDocument 405 /error.php
ErrorDocument 500 /error.php
ErrorDocument 503 /error.php
