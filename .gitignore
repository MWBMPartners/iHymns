# ----------------------------------------------------------------------------
# Database Credentials (appWeb/.auth/)
# The real credentials file is never committed; only the example template.
# ----------------------------------------------------------------------------
appWeb/.auth/*
!appWeb/.auth/.htaccess
!appWeb/.auth/db_credentials.example.php

# ----------------------------------------------------------------------------
# Secrets / Credentials (NEVER commit these)
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
sftp-config.json
.htpasswd
.htpasswd-*

# ----------------------------------------------------------------------------
# Generated Data (re-generated from .SourceSongData/)
# ----------------------------------------------------------------------------
# Canonical songs.json is still tracked in data/ (generated by parse-songs.js).
# The runtime copy in data_share/ and deploy copies are excluded.
appWeb/data_share/song_data/songs.json
appWeb/data_share/setlist_json/*.json
appWeb/data_share/*
appWeb/public_html/data/songs.json
appWeb/private_html/data/songs.json
# Local-only importer sample decks (large binaries, not source-of-truth)
data/Import file examples/
data/.DS_Store

# CI/CD injected environment channel file (deploy-time only)
appWeb/public_html/.env-channel

# ----------------------------------------------------------------------------
# Source Scraped Song data
# ----------------------------------------------------------------------------
.SourceSongData/*
SourceSongData/*
*_debug_*_raw.html
*_debug_*_skipped.html

# Legacy SQLite copy of the user DB (holds password hashes — must never land
# in the repo; recover from git history if a deployment hasn't migrated).
SQLite/

# ----------------------------------------------------------------------------
# Vendor libraries — generated by tools/download-vendor.sh (#354 / #526)
# ----------------------------------------------------------------------------
# Bootstrap, FontAwesome, jQuery, Animate.css, Fuse.js, Tone.js, PDF.js
# downloaded as PWA offline-fallback for the onerror handlers in index.php.
# Re-generated on every deploy by deploy.yml; do not commit.
appWeb/public_html/vendor/

# ----------------------------------------------------------------------------
# Python bytecode (#967)
# Generated by `python3 -m py_compile` or normal module imports. One .pyc
# was accidentally committed under .importers/scrapers/__pycache__/ in
# the past; this rule prevents recurrence and untracks the orphan via
# the accompanying `git rm`.
# ----------------------------------------------------------------------------
__pycache__/
*.pyc

# ----------------------------------------------------------------------------
# GitHub Wiki sibling clone (#958)
# ----------------------------------------------------------------------------
# GitHub stores wikis as a separate git repo (`<project>.wiki.git`); cloning
# it alongside the main repo lets Claude / IDEs read wiki content without a
# network round-trip. The clone is its own repository — never commit it
# inside the main repo.
# Directory form (no trailing /*) is required to suppress an *embedded git
# repo* — a nested clone is a gitlink that `iHymns.wiki/*` does not ignore.
iHymns.wiki/
iHymns.wiki/*
iHymns.wiki.git/
iHymns.wiki.git/*