tools/media-lang/check_copies.py -text -filter -working-tree-encoding -ident
appWeb/public_html/includes/vendor/media-language/MediaLanguagePolicy.php -text -filter -working-tree-encoding -ident
appWeb/public_html/includes/vendor/media-language/bcp47-language-data-v1.json -text -filter -working-tree-encoding -ident
